# ─────────────────────────────────────────────────────────────────────────────
# Smart Operations Hub — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django core ───────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=changeme-generate-a-real-key

# Set to "false" in production, "true" for local development only
DJANGO_DEBUG=false

# Comma-separated list of allowed hostnames (no wildcards in production)
# Example: myapp.onrender.com,api.myapp.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Frontend origins (CORS + CSRF) ────────────────────────────────────────────
# Comma-separated list of allowed frontend URLs (no trailing slash)
# Example: https://myapp.onrender.com,https://www.myapp.com
FRONTEND_ORIGINS=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (dev). Set to Postgres URL for production.
# Format: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Set to "1" to force SQLite even when DATABASE_URL is set (useful for local dev)
# USE_SQLITE=1

# ── Timezone ──────────────────────────────────────────────────────────────────
DJANGO_TIME_ZONE=Asia/Riyadh

# ── Optional overrides ────────────────────────────────────────────────────────
# Force a specific net-sales figure in reports (remove when Foodics sync is correct)
# NET_SALES_OVERRIDE=
